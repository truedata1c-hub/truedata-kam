{
  "name": "truedata-kam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PharmaCheck · Переговоры: переговорные кампании КАМ с аптечными сетями",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/cli.ts migrate",
    "admin": "tsx src/cli.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^8.3.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
